{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ff7recomp.local/ff7pkg.schema.json",
  "title": "FF7Recomp GamePackage manifest",
  "type": "object",
  "required": [
    "format",
    "tool_version",
    "created_at",
    "exe_name",
    "exe_sha256",
    "exe_size",
    "platform"
  ],
  "properties": {
    "format": { "const": "ff7pkg-v1" },
    "tool_version": { "type": "string" },
    "created_at": { "type": "string" },
    "exe_name": { "type": "string" },
    "exe_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "exe_size": { "type": "integer", "minimum": 1 },
    "platform": { "const": "ios-arm64" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
